# TypeSafe Jev — typed classification (required)
TYPESAFE_API_KEY=

# NVIDIA API Catalog — open chat model that writes the reply (required)
# Use the bearer token from build.nvidia.com as its own KEY=value line.
NVIDIA_API_KEY=

# Optional overrides
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=openai/gpt-oss-20b
# NVIDIA_TIMEOUT_MS=12000
# NVIDIA_MAX_TOKENS=220
# PORT=3001
